{
	"$schema": "https://opencode.ai/config.json",
	"instructions": ["AGENTS.md", "docs/**/*.md"],
	"permission": {
		"read": "allow",
		"edit": "ask",
		"todoread": "allow",
		"grep": "allow",
		"glob": "allow",
		"list": "allow",
		"lsp": "allow",
		"skill": "allow",
		"rm -rf *": "ask",
		"gh": "ask",
		"bash": "ask",
		"mkdir": "ask"
	},
	"mcp": {
		"playwright": {
			"type": "local",
			"command": ["npx", "@playwright/mcp@latest"],
			"enabled": true
		},
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		}
	}
}
